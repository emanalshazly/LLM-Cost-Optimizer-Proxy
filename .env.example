# Server Configuration
PORT=3001
NODE_ENV=development

# MongoDB Configuration
# Local: mongodb://localhost:27017/llm-cost-optimizer
# Vercel: Use MongoDB Atlas connection string
# Example: mongodb+srv://username:password@cluster.mongodb.net/llm-cost-optimizer
MONGODB_URI=mongodb://localhost:27017/llm-cost-optimizer

# Redis Configuration
# Local: redis://localhost:6379
# Vercel: Use Upstash Redis URL
# Example: redis://default:password@endpoint.upstash.io:port
REDIS_URL=redis://localhost:6379

# LLM API Keys
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
GOOGLE_API_KEY=your_google_key_here

# Cost Optimization Settings
ENABLE_CACHING=true
CACHE_TTL=3600
ENABLE_PROMPT_OPTIMIZATION=true
ENABLE_SMART_ROUTING=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Dashboard Configuration
DASHBOARD_SECRET=your_dashboard_secret_here