# Server Configuration
PORT=3001
NODE_ENV=development

# --- Optional infrastructure -------------------------------------------------
# The proxy starts with ZERO infrastructure: without MongoDB/Redis it falls
# back to in-memory caching and request logging. Set these to enable durable
# storage and a shared cache.

# MongoDB (request logging & analytics) — leave empty to use the in-memory store
MONGODB_URI=
# Example: MONGODB_URI=mongodb://localhost:27017/llm-cost-optimizer

# Redis (cache backend) — leave empty to use the in-memory cache
REDIS_URL=
# Example: REDIS_URL=redis://localhost:6379

# --- LLM API Keys ------------------------------------------------------------
# Placeholders only — never commit real keys.
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
GOOGLE_API_KEY=your_google_key_here
# GOOGLE_API_KEY is only required to call gemini-* models directly via LLMProvider.

# --- Feature Flags -----------------------------------------------------------
ENABLE_CACHING=true
CACHE_TTL=3600
ENABLE_PROMPT_OPTIMIZATION=true
ENABLE_SMART_ROUTING=true
ENABLE_REQUEST_LOGGING=true

# --- Rate Limiting -----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# --- API Authentication -------------------------------------------------------
# When set, /api/proxy and /api/dashboard require this value in the x-api-key
# header. Leave empty to run without authentication (a startup warning is
# logged) — fine for local development, not for anything reachable publicly.
API_KEY=

# --- Misc --------------------------------------------------------------------
LLM_REQUEST_TIMEOUT_MS=30000
LOG_LEVEL=info
